{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvin.app/schemas/encounter.schema.json",
  "title": "Corvin Encounter Data",

  "type": "object",

  "additionalProperties": {
    "type": "array",
    "items": {
      "$ref": "#/$defs/encounter"
    }
  },

  "$defs": {
    "encounter": {
      "type": "object",
      "required": [
        "id",
        "participants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "mechanics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanic"
          }
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      },
      "additionalProperties": false
    },

    "participant": {
      "type": "object",
      "required": [
        "enemy",
        "role"
      ],
      "properties": {
        "enemy": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

    "mechanic": {
      "type": "object",
      "required": [
        "id",
        "trigger"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "advice": {
          "$ref": "#/$defs/advice"
        },
        "once": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

    "trigger": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "timing": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "value": {},
        "op": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/simpleCondition"
        },
        {
          "$ref": "#/$defs/conditionGroup"
        }
      ]
    },

    "simpleCondition": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "contains"
          ]
        },
        "value": {}
      },
      "additionalProperties": false
    },

    "conditionGroup": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },

    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "caster": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "spell": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "count": {
          "type": "integer"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "advice": {
      "type": "object",
      "required": [
        "type",
        "subject"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "schedule": {
      "type": "object",
      "required": [
        "id",
        "start_round",
        "period"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start_round": {
          "type": "integer",
          "minimum": 1
        },
        "period": {
          "type": "integer",
          "minimum": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduleEvent"
          }
        }
      },
      "additionalProperties": false
    },

    "segment": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segmentEvent"
          }
        }
      },
      "additionalProperties": false
    },

    "segmentEvent": {
      "type": "object",
      "required": [
        "when",
        "actions"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/scheduleWhen"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "advice": {
          "$ref": "#/$defs/advice"
        }
      },
      "additionalProperties": false
    },

    "scheduleEvent": {
      "type": "object",
      "required": [
        "round",
        "timing",
        "actions"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "timing": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "advice": {
          "$ref": "#/$defs/advice"
        }
      },
      "additionalProperties": false
    },

    "scheduleWhen": {
      "type": "object",
      "required": [
        "type",
        "timing"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "every_round",
            "segment_round"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "timing": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "additionalProperties": false
    },

    "state": {
      "type": "object",
      "properties": {
        "mechanics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanic"
          }
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          }
        }
      },
      "additionalProperties": false
    },

    "transition": {
      "type": "object",
      "required": [
        "from",
        "to",
        "trigger"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      },
      "additionalProperties": false
    }
  }
}