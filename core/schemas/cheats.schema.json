{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ravendex Enemy Cheats",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["mechanics"],
    "additionalProperties": false,
    "properties": {
      "mechanics": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "schedule": {
              "type": "object",
              "required": ["events"],
              "additionalProperties": false,
              "properties": {
                "repeat": {"type": "integer", "minimum": 1},
                "timing": {"type": "string", "enum": ["start", "end"]},
                "events": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["round", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "round": {"type": "integer", "minimum": 1},
                      "timing": {"type": "string", "enum": ["start", "end"]},
                      "text": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            },
            "id": {"type": "string", "minLength": 1},
            "notes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
