{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ravendex Enemy Cheats",
  "$defs": {
    "enemyReferences": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["enemy"], "additionalProperties": false,
        "properties": {
          "enemy": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "oneOf": [
      {"required": ["ref"], "not": {"anyOf": [{"required": ["mechanics"]}, {"required": ["strategy"]}]}},
      {"not": {"required": ["ref"]}, "anyOf": [{"required": ["mechanics"]}, {"required": ["strategy"]}]}
    ],
    "additionalProperties": false,
    "properties": {
      "ref": {"type": "string", "minLength": 1},
      "strategy": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object", "required": ["id"], "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "enemies": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object", "required": ["enemy"], "additionalProperties": false,
                    "properties": {
                      "enemy": {"type": "string", "minLength": 1},
                      "label": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "mechanics": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "schedule": {
              "type": "object",
              "required": ["events"],
              "additionalProperties": false,
              "properties": {
                "repeat": {"type": "integer", "minimum": 1},
                "timing": {"type": "string", "enum": ["start", "end"]},
                "events": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["round", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "round": {"type": "integer", "minimum": 1},
                      "timing": {"type": "string", "enum": ["start", "end"]},
                      "text": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            },
            "id": {"type": "string", "minLength": 1},
            "enemies": {"$ref": "#/$defs/enemyReferences"},
            "notes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
