{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ravendex Enemy Cheats",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["mechanics"],
    "additionalProperties": false,
    "properties": {
      "mechanics": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "notes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
